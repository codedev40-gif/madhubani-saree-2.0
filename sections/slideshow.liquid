
<div class="main_container">
  <div class="slider slider-nav{{ section.id }}">
    {% for block in section.blocks %}

    <div class="home-ban">
        {% if block.settings.image != blank %}
      <a href="{{ block.settings.link }}"> 
        <div class="banner-sec backimage lazyload desktop-ban"
             style="background-image:url('{{ block.settings.image | img_url:'1920x' }}')">
          <svg class="transparent_svg" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1921 1025">
            <rect class="cls-1" x="0.5" y="0.5" width="1920" height="1024"></rect>
          </svg>
        </div>    
      </a>  
       {% else %}
      <div class="banner-sec backimage lazyload desktop-ban"> 
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }} 
     </div> 
      {% endif %}
       {% if block.settings.mimage != blank %}
      <a href="{{ block.settings.link }}"> 
        <div class="banner-sec backimage lazyload mobile-ban"
             style="background-image:url('{{ block.settings.mimage | img_url:'750x' }}')">
          <svg class="transparent_svg" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 751 1001">
            <rect class="cls-1" x="0.5" y="0.5" width="750" height="1000"></rect>
          </svg>
        </div>  
      </a>
      {% else %}      
     <a href="{{ block.settings.link }}"> 
        <div class="banner-sec backimage lazyload desktop-banmobile"
             style="background-image:url('{{ block.settings.image | img_url:'750x' }}')">
          <svg class="transparent_svg" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 751 1001">
            <rect class="cls-1" x="0.5" y="0.5" width="750" height="1000"></rect>
          </svg>
        </div>
      </a>   
      {% endif %}  
      <div class="banner__box color-background-1 bantextbox"><h2 class="banner__heading h1">
        {% if block.settings.heading != blank  %}
              <span>{{ block.settings.heading }}</span>
        {% endif %}
            </h2>
            <div class="banner__text">
             {% if block.settings.para != blank  %}   
              <span>{{ block.settings.para }}</span>
              {% endif %}
            </div>
         {% if block.settings.btnname != blank and block.settings.link != blank   %}        
        <div class="banner__buttons"><a href="{{ block.settings.link }}" class="button button--primary">{{ block.settings.btnname }}</a>
          {% endif %}
        </div>
      </div>
      </div> 
    {% endfor %}
  </div>
</div>
<style>
  
.bantextbox span {
    color: #fff;
}
  .banner__box.color-background-1.bantextbox {
    max-width: 100%;
    position: absolute;
    width: 100%;
    top: 70%;
    background: transparent;
    left: 50%;
    transform: translate(-50%, -50%);
}
  
.home-ban {
    position: relative;
}
  
  .home-ban::before
  {
    content: "";
    position: absolute;
    left: 0; right: 0;
    top: 0; bottom: 0;
    background: rgba(0,0,0,.1);   
  } 
  @media (min-width:769px){  
    .home-ban .mobile-ban,.desktop-banmobile
    {
      display:none !important;
    }    
  }
  @media(max-width:768px){  
    .home-ban .desktop-ban
    {
      display:none !important;
    }    
  }  
.main_container {
    width: 100%;
    height: 100%;
}
  .home-ban img {
    width: 100%;
    height: 100%;
  } 
svg:not(:root) {
    overflow: hidden;
}

    .transparent_svg {
    opacity: 0;
    fill: transparent;
    stroke: transparent;
    stroke-miterlimit: 0;
}

.backimage
{
background-position: center center !important;
background-size: cover !important;
background-repeat: no-repeat !important;
}  
  
</style>


<script type="text/javascript">
  $('.slider-nav{{ section.id }}').slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    arrows: false,
    fade: false,
    cssEase: 'linear',
    infinite: true,
    autoplay: false,
    dots: true,
    pauseOnHover:false
  });
</script>


{% schema %}
{
"name": "Slideshow",
"settings": [
],
"blocks": [
{
"name": "Banner slider",
"type": "block",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Desktop Image",
"info":"1920 X 750 recommended"
},
{
"type": "image_picker",
"id": "mimage",
"label": "Mobile Image",
"info":"750 X 1000 recommended"
},  
{
"type": "text",
"id": "heading",
"label": "Heading"
},
{
"type": "textarea",
"id": "para",
"label": "Content"
},
{
"type": "text",
"id": "btnname",
"label": "Button Name"
},
{
"type": "url",
"id": "link",
"label": "Link"
}
]
}
],
"presets": [{
"name": "Slideshow",
"category": "Image"
}
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}